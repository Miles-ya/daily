  "properties": {
    "why_for_me": {"type": "string"},
    "action_today": {"type": "string"},
    "continue_watching": {"type": "array", "items": {"type": "string"}},
    "new_directions": {"type": "array", "items": {"type": "string"}},
    "suggested_judgement_changes": {"type": "array", "items": {"type": "string"}},
    "ignore_reason": {"type": "string"}
  }
}
